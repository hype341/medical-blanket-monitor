# 应用端口
APP_PORT=3000

# 项目名称
VITE_APP_TITLE=医用智能毯安全监护平台

# 代理前缀
VITE_API_BASE=/dev-api

# 接口地址（开发代理转发目标，默认走线上）
API_PROXY_TARGET=https://www.youlai.tech     # 线上
# API_PROXY_TARGET=http://localhost:8000       # 本地

# Mock 开关（当前项目尚无业务后端，本地开发使用内置 Mock）
VITE_MOCK_ENABLED=true

# 当前产品使用静态路由，后续接入 Java 权限菜单时改为 true
VITE_DYNAMIC_ROUTES_ENABLED=false

# 多租户开关
VITE_TENANT_ENABLED=false

# AI 开关
VITE_AI_ENABLED=false

# 统一认证登录开关
VITE_OIDC_ENABLED=false
