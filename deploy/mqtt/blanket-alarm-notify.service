[Unit]
Description=Blanket developer MQTT alarm notification API
After=network.target

[Service]
Type=simple
EnvironmentFile=/etc/blanket/system-time.env
ExecStart=/usr/bin/python3 /opt/blanket/alarm-notify-service.py
Restart=always
RestartSec=3
User=www-data
Group=www-data
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
