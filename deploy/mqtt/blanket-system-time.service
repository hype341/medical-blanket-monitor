[Unit]
Description=Medical blanket MQTT server time publisher
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
EnvironmentFile=/etc/blanket/system-time.env
ExecStart=/usr/bin/python3 /opt/blanket-sensor/system-time-service.py
Restart=always
RestartSec=1
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/www/blanket-system

[Install]
WantedBy=multi-user.target
