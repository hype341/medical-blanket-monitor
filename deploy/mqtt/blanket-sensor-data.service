[Unit]
Description=Medical blanket latest sensor data collector
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
EnvironmentFile=/etc/blanket/mqtt-sensor.env
ExecStart=/usr/bin/python3 /opt/blanket-sensor/sensor-data-service.py
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/www/blanket-sensor-data

[Install]
WantedBy=multi-user.target
